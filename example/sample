Adding a sixth cash type is: one Instruction implementation, one satellite table, one rail adapter, one workflow definition row set. No change to Redemption, the engine, the status model, or the event contract.

7.3 Behaviour on the aggregate
// PlaceHold records a confirmed ledger hold. Enforces I1 and I2.
func (r *Redemption) PlaceHold(h Hold) error {
    if r.Status != StatusAuthorizing {
        return ErrInvalidTransition{From: r.Status, Op: "place_hold"}
    }
    if r.Hold != nil && r.Hold.IsActive() {
        return ErrHoldAlreadyActive
    }
    r.Hold = &h
    r.transition(StatusAuthorized)
    r.raise(PointsHeld{RedemptionID: r.ID, Points: h.Points, Ref: h.LedgerRef})
    return nil
}

// Settle converts the hold to a permanent debit. Terminal for the happy path (I2, I7).
func (r *Redemption) Settle(at time.Time) error {
    if r.Hold == nil || r.Hold.State != HoldHeld {
        return ErrNoSettleableHold
    }
    if !r.Status.In(StatusFulfilling, StatusAwaitingSettlement) {
        return ErrInvalidTransition{From: r.Status, Op: "settle"}
    }
    r.Hold.State, r.Hold.SettledAt = HoldSettled, &at
    r.transition(StatusCompleted)
    r.raise(PointsSettled{RedemptionID: r.ID, Points: r.Points})
    r.raise(RedemptionFulfilled{RedemptionID: r.ID, Subtype: r.Subtype})
    return nil
}

// Reverse applies a post-settlement correction. Never a rollback: a new
// compensating ledger entry, and the original settlement stays on the record.
func (r *Redemption) Reverse(rv Reversal) error {
    if r.Status != StatusCompleted && r.Status != StatusReversed {
        return ErrInvalidTransition{From: r.Status, Op: "reverse"}
    }
    r.Reversals = append(r.Reversals, rv)
    r.transition(StatusReversed)
    r.raise(RedemptionReversed{RedemptionID: r.ID, Trigger: rv.Trigger, Code: rv.RailCode})
    return nil
}

func (r *Redemption) transition(to Status) {
    if !allowed[r.Status][to] {            // table-driven, mirrors §5.1
        panic("illegal transition escaped a guard: " + string(r.Status) + "->" + string(to))
    }
    r.Status = to
}
