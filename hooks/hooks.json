{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PLUGIN_ROOT/hooks/validate-on-write.py\"",
            "statusMessage": "Validating .contextrover/ artifacts",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
